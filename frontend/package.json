    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "4.5.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
