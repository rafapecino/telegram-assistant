# Copia este archivo como .env y rellena los valores.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Cadena aleatoria: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=

# Protege /jobs/* y /telegram/setup-webhook. Otra cadena aleatoria.
INTERNAL_SECRET=

# Contraseña del panel web (gastos y recordatorios). Otra cadena aleatoria.
PANEL_TOKEN=

# IA
GROQ_API_KEY=

# Banco. La clave puede ir en una sola línea con los saltos escritos como \n.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=

# Postgres (por ejemplo, la cadena "Session pooler" de Supabase)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres

# URL pública de la API, sin barra final
PUBLIC_BASE_URL=https://tu-api.example.com

# Pon false en las réplicas que no deban lanzar las tareas programadas
ENABLE_SCHEDULER=true

# Nivel de los logs: DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO

# true para activar la documentación interactiva en /docs (déjalo en false en producción)
ENABLE_DOCS=false
